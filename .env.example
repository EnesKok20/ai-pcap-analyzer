ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3

# --- Kimlik dogrulama (opsiyonel - bos birakilirsa ilk calistirmada otomatik
# uretilip bu dosyaya yazilir, terminalde bir kerelik gosterilir) ---
# APP_PASSWORD=
# SECRET_KEY=

# --- Sunucu ayarlari (opsiyonel) ---
# FLASK_DEBUG=true sadece yerel gelistirmede kullanilmali, production'da asla acik birakilmamali.
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Dogrudan Flask uzerinden HTTPS test etmek icin (onerilmez - production'da reverse proxy kullanin):
# SSL_CERT_PATH=
# SSL_KEY_PATH=
# Rate limiting icin kalici/paylasimli depolama (opsiyonel - tanimsizsa bellek ici depolama kullanilir):
# REDIS_URL=redis://localhost:6379
